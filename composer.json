{
    "name": "emagister/collections",
    "type": "library",
    "description": "The Emagister Collections project provides a set of collection classes for PHP.",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.0",
        "squizlabs/php_codesniffer": "^3.0",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": {
            "Emagister\\Collections\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emagister\\Collections\\Tests\\": "tests",
            "Emagister\\Collections\\Examples\\": "examples"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -exec php -l {} \\;",
        "tests": "phpunit",
        "phpcs": "phpcs",
        "cs-fixer": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "infection": "infection --threads=max",
        "infection:diff": "infection --threads=max --git-diff-lines --git-diff-base=origin/main --min-msi=100 --min-covered-msi=100 --ignore-msi-with-no-mutations"
    },
    "version": "2.0.2"
}
